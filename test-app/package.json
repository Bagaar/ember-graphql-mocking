    "ember-source-channel-url": "3.0.0",
    "ember-template-lint": "7.9.4",
    "ember-try": "4.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ember": "13.9.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-qunit": "8.2.6",
    "graphql": "16.14.2",
    "loader.js": "4.7.0",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "qunit": "2.26.0",
    "qunit-dom": "3.6.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-prettier": "5.0.3",
    "tracked-built-ins": "4.1.2",
    "typescript": "5.9.3",
    "webpack": "5.112.2"
