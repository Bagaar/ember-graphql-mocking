    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "tsc --noEmit",
    "start": "ember serve",
    "test": "ember test"
  },
  "devDependencies": {
    "@apollo/client": "3.14.1",
    "@babel/core": "7.29.7",
